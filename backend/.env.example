DB_HOST=localhost
DB_PORT=3306
DB_NAME=tdeavox
DB_USER=root
DB_PASSWORD=cambia-esto

# Secreto largo y aleatorio, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRATION=7d

PORT=8080
# Origenes del frontend permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Intentos maximos de registro/login por IP cada 15 minutos
AUTH_RATE_MAX=30

# Admin inicial (lo crea `npm run db:init`); deja vacio para no crearlo
ADMIN_CORREO=admin@tdea.edu.co
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-ya

# Produccion: NODE_ENV=production exige HTTPS (el proxy debe enviar X-Forwarded-Proto)
# NODE_ENV=production
