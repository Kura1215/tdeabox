spring.application.name=tdeavox

# MySQL - Configuracion de conexion a la base de datos
spring.datasource.url=jdbc:mysql://localhost:3306/tdeavox?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=PEDIR_AL_EQUIPO
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate - Validacion del esquema de la base de datos
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect

# Subida de archivos - Limite de tamaño para imagenes
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# JWT - Clave secreta y tiempo de expiracion (24 horas)
jwt.secret=PEDIR_AL_EQUIPO
jwt.expiration=86400000

# Puerto del servidor backend
server.port=8080
